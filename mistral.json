{
  "schemaVersion": 2,
  "kind": "app",
  "name": "typist",
  "deployment": {
    "organizationId": "c497d07e-eb8e-479b-8048-d60d2d4aebf5",
    "workspaceId": "5e4ba0f6-5238-4c09-a56a-94e38bd8fbbb",
    "appId": "01a1a849-96da-753a-ad18-ce0005571ee4"
  },
  "modules": [
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    }
  ]
}
